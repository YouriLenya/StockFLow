
<Window x:Class="StockFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockFlow - Gestion des produits"
        Height="550"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F6FA" Margin="20">
        <StackPanel>

            <TextBlock
                Text="StockFlow"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#1E293B"
                Margin="0,0,0,10"/>

            <TextBlock
                Text="Gestion des produits"
                FontSize="18"
                Foreground="#64748B"
                Margin="0,0,0,20"/>

            <DataGrid
                ItemsSource="{Binding Products}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                RowHeight="40">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Référence"
                        Binding="{Binding Reference}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Produit"
                        Binding="{Binding Name}"
                        Width="2*"/>

                    <DataGridTextColumn
                        Header="Quantité"
                        Binding="{Binding Quantity}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Stock minimum"
                        Binding="{Binding MinimumStock}"
                        Width="*"/>

                    <DataGridCheckBoxColumn
                        Header="Stock faible"
                        Binding="{Binding IsLowStock, Mode=OneWay}"
                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>
    </Grid>
</Window>
