
<Window x:Class="StockFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockFlow - Gestion des stocks"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F6FA">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="Bienvenue sur StockFlow"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#1E293B"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Votre solution de gestion des stocks"
                FontSize="16"
                Foreground="#64748B"
                Margin="0,15,0,25"
                HorizontalAlignment="Center"/>

            <Button
                Content="Commencer"
                Width="180"
                Height="45"
                FontSize="15"
                Background="#2563EB"
                Foreground="White"/>

        </StackPanel>
    </Grid>
</Window>
